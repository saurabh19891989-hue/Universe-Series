 "subtitles": true,
 "dialogue": [
  {
   "id": "3-01",
   "who": "mira",
   "start_s": 7.0,
   "dur": 0.73,
   "text": "Next.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L001_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L001_MIRA.json"
  },
  {
   "id": "3-02",
   "who": "jax",
   "start_s": 7.93,
   "dur": 1.088,
   "text": "There's no one else here.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L002_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L002_JAX.json"
  },
  {
   "id": "3-03",
   "who": "mira",
   "start_s": 9.218,
   "dur": 1.724,
   "text": "It's procedure. Next.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L003_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L003_MIRA.json"
  },
  {
   "id": "3-04",
   "who": "mira",
   "start_s": 11.192,
   "dur": 6.319,
   "text": "Parcel, one. Sealed. Addressed to a district withdrawn at fourteen-oh-two. Seized at fourteen-nineteen.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L004_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L004_MIRA.json"
  },
  {
   "id": "3-05",
   "who": "jax",
   "start_s": 17.841,
   "dur": 1.64,
   "text": "Here's my situation. My aunt\u2014",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L005_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L005_JAX.json"
  },
  {
   "id": "3-06",
   "who": "mira",
   "start_s": 19.371,
   "dur": 1.436,
   "text": "You don't have an aunt.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L006_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L006_MIRA.json"
  },
  {
   "id": "3-07",
   "who": "jax",
   "start_s": 21.007,
   "dur": 0.87,
   "text": "You don't know that.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L007_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L007_JAX.json"
  },
  {
   "id": "3-08",
   "who": "mira",
   "start_s": 22.077,
   "dur": 2.337,
   "text": "Your form says next of kin: none.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L008_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L008_MIRA.json"
  },
  {
   "id": "3-09",
   "who": "jax",
   "start_s": 24.615,
   "dur": 4.489,
   "text": "She's very distant. Look \u2014 I can tell you're someone who appreciates flexibility.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L009_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L009_JAX.json"
  },
  {
   "id": "3-10",
   "who": "mira",
   "start_s": 29.433,
   "dur": 3.472,
   "text": "I'm a cartographer. I appreciate where things actually are.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L010_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L010_MIRA.json"
  },
  {
   "id": "3-11",
   "who": "jax",
   "start_s": 33.235,
   "dur": 3.469,
   "text": "Then you'll appreciate the Lunar Courier Exemption. Section twelve.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L011_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L011_JAX.json"
  },
  {
   "id": "3-12",
   "who": "mira",
   "start_s": 37.034,
   "dur": 1.667,
   "text": "There are nine sections.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L012_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L012_MIRA.json"
  },
  {
   "id": "3-13",
   "who": "jax",
   "start_s": 38.901,
   "dur": 1.679,
   "text": "Which is why twelve is so exclusive.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L013_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L013_JAX.json"
  },
  {
   "id": "3-14",
   "who": "mira",
   "start_s": 42.381,
   "dur": 4.057,
   "text": "Is there anything true you'd like to tell me, Captain? Before I stamp it.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L014_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L014_MIRA.json"
  },
  {
   "id": "3-15",
   "who": "jax",
   "start_s": 46.768,
   "dur": 1.297,
   "text": "I'm very good at my job.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L015_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L015_JAX.json"
  },
  {
   "id": "3-16",
   "who": "mira",
   "start_s": 48.265,
   "dur": 2.353,
   "text": "You're four hours from losing your ship.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L016_MIRA.wav",
   "lips": "${TOON}/lips/E01_S03_L016_MIRA.json"
  },
  {
   "id": "3-17",
   "who": "jax",
   "start_s": 50.818,
   "dur": 1.102,
   "text": "I'm good at it in bursts.",
   "src": "${SCRATCH}/e01/dialogue/E01_S03_L017_JAX.wav",
   "lips": "${TOON}/lips/E01_S03_L017_JAX.json"
  }
 ],
