 "dialogue": {
  "lines": [
   {
    "id": "0-01",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L001_PIP.wav",
    "start_s": 2.0,
    "text": "Captain. The bank has taken the left engine."
   },
   {
    "id": "0-02",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L002_JAX.wav",
    "start_s": 4.725,
    "text": "Which one's the left?"
   },
   {
    "id": "0-03",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L003_PIP.wav",
    "start_s": 5.86,
    "text": "The one that has stopped."
   },
   {
    "id": "0-04",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L004_PIP.wav",
    "start_s": 7.518,
    "text": "And the navigation lights. And the heating. And the coffee machine."
   },
   {
    "id": "0-05",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L005_JAX.wav",
    "start_s": 11.604,
    "text": "They can't take the coffee machine."
   },
   {
    "id": "0-06",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L006_PIP.wav",
    "start_s": 13.239,
    "text": "It was financed separately."
   },
   {
    "id": "0-07",
    "speaker": "TEMI",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L007_TEMI_treated.wav",
    "start_s": 15.304,
    "text": "Good morning! This is Temi in Recoveries. Your vessel is being recovered."
   },
   {
    "id": "0-08",
    "speaker": "TEMI",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L008_TEMI_treated.wav",
    "start_s": 19.073,
    "text": "Full recovery, including the air, at six tonight, lunar time. Please remain seated while—"
   },
   {
    "id": "0-09",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L009_JAX.wav",
    "start_s": 23.434,
    "text": "Temi! Hi! I'm about to make a payment—"
   },
   {
    "id": "0-10",
    "speaker": "TEMI",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L010_TEMI_treated.wav",
    "start_s": 26.329,
    "text": "—we disable your—"
   },
   {
    "id": "0-11",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L011_JAX.wav",
    "start_s": 27.251,
    "text": "A big one. Enormous—"
   },
   {
    "id": "0-12",
    "speaker": "TEMI",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L012_TEMI_treated.wav",
    "start_s": 28.177,
    "text": "Hello! You're speaking to Temi in Recoveries!"
   },
   {
    "id": "0-13",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L013_JAX.wav",
    "start_s": 30.636,
    "text": "Why does she keep doing that?"
   },
   {
    "id": "0-14",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L014_PIP.wav",
    "start_s": 32.088,
    "text": "She is in Lagos. You are arguing with the past."
   },
   {
    "id": "0-15",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L015_JAX.wav",
    "start_s": 35.389,
    "text": "And I'm winning."
   },
   {
    "id": "0-16",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L016_PIP.wav",
    "start_s": 37.28,
    "text": "A job, posted to us directly. One parcel, sealed, prepaid. Shackleton crater, by six tonight. The fee is—"
   },
   {
    "id": "0-17",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L017_JAX.wav",
    "start_s": 44.369,
    "text": "Is?"
   },
   {
    "id": "0-18",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L018_PIP.wav",
    "start_s": 45.019,
    "text": "Exactly what we owe. To the cent."
   },
   {
    "id": "0-19",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L019_JAX.wav",
    "start_s": 47.531,
    "text": "Take it."
   },
   {
    "id": "0-20",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L020_PIP.wav",
    "start_s": 48.324,
    "text": "You have not read the—"
   },
   {
    "id": "0-21",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L021_JAX.wav",
    "start_s": 49.484,
    "text": "Take it take it take it take it—"
   },
   {
    "id": "0-22",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L022_PIP.wav",
    "start_s": 50.731,
    "text": "Accepted. I am also filing a report on you. Once is binding."
   },
   {
    "id": "0-23",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L023_JAX.wav",
    "start_s": 56.267,
    "text": "Who sends a parcel to a crater?"
   },
   {
    "id": "0-24",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L024_PIP.wav",
    "start_s": 57.964,
    "text": "Someone who knew precisely how much we owed."
   },
   {
    "id": "0-25",
    "speaker": "JAX",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L025_JAX.wav",
    "start_s": 60.986,
    "text": "Lucky."
   },
   {
    "id": "0-26",
    "speaker": "PIP",
    "src": "${SCRATCH}/e01/dialogue/E01_S00_L026_PIP.wav",
    "start_s": 61.672,
    "text": "Filed under \"arithmetic\"."
   }
  ]
 },
